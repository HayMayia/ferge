# Optional local gateway settings. Copy to .env, which is ignored by Git.
PORT=3001

# Leave both blank for local, trusted-network use only.
# Before allowing the published website to connect, generate a unique key:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never put a real key in source code, a URL, a commit, or a chat message.
GATEWAY_TOKEN=

# Remote access requires GATEWAY_TOKEN and an HTTPS reverse proxy/tunnel.
# Exact origins, comma-separated; no wildcard, trailing slash, or /ferge/ path.
# Example: ALLOWED_ORIGINS=https://haymayia.github.io
ALLOWED_ORIGINS=
