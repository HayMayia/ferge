{
  "name": "smartfarm-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/ferge/ --outDir docs",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "vitest run",
    "check": "tsc -b && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
